# FedMed .gitignore
# HIPAA / GDPR: Never commit raw patient data, imaging files, or patient-identifying paths

# Patient data and raw imaging files (root data directory only)
/data/
*.nii
*.nii.gz
*.dcm
*.dicom
*.ima
*.mha
*.nrrd

# Model checkpoints and weights
/checkpoints/
*.pt
*.pth

# Tensorboard runs and training outputs
/runs/
/outputs/

# Frontend dependencies and builds
node_modules/
/dashboard/dist/
/dashboard/node_modules/

# Python virtual environments
.venv/
venv/
env/
.env
.env.*

# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Testing and linters
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Cache directories
/cache/
.cache/
.monai/

# IDE and editor configuration
.cursor/
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Temporary and scratch artifacts
temp_chrome/
*.tmp
*.log
/results/test_metrics.json
/results/baseline_metrics.json

# TLS / SSL Certificates, Private Keys, and Credentials (Rule 5)
/certificates/
/certs/
/keys/
*.tenseal
*.pem
*.key
*.crt
*.csr
*.pfx
*.p12

# Visualization outputs
*.png
